  "info": {
    "title": "VideoBridge API",
    "description": "REST API for the VideoBridge phone and TV apps. Every non-2xx response uses the error envelope.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "env": {
            "type": "string",
            "enum": [
              "development",
              "staging",
              "production"
            ],
            "example": "development"
          },
          "version": {
            "type": "string",
            "description": "Git SHA of the build, or the package version.",
            "example": "0.1.0"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-07T16:26:52.123Z"
          }
        },
        "required": [
          "status",
          "env",
          "version",
          "time"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up"
          },
          "redis": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "disabled"
            ],
            "example": "disabled"
          }
        },
        "required": [
          "db",
          "redis"
        ]
      },
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "NOT_READY"
          },
          "message": {
            "type": "string",
            "example": "The service is not ready."
          },
          "details": {
            "type": "object",
            "example": {
              "checks": {
                "db": "up",
                "redis": "down"
              }
            }
          },
          "requestId": {
            "type": "string",
            "example": "0192f3c4-7a10-7c3e-9b1f-2d5e8a6c4b10"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "DeviceDto": {
        "type": "object",
        "properties": {
          "installId": {
            "type": "string",
            "description": "Random id created by the app on first launch."
          },
          "type": {
            "type": "string",
            "enum": [
              "PHONE",
              "ANDROID_TV"
            ]
          },
          "name": {
            "type": "string",
            "example": "OnePlus 13"
          },
          "manufacturer": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "osVersion": {
            "type": "string"
          },
          "appVersion": {
            "type": "string"
          }
        },
        "required": [
          "installId",
          "type",
          "name"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "9876543210",
            "description": "Mobile number; +91 is assumed without a country code."
          },
          "password": {
            "type": "string",
            "description": "Any password of 1 to 200 characters."
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          },
          "name": {
            "type": "string",
            "example": "Janak"
          }
        },
        "required": [
          "phone",
          "password",
          "device",
          "name"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "phoneMasked": {
            "type": "string",
            "example": "+91******3210"
          },
          "displayName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "phoneMasked",
          "displayName",
          "createdAt"
        ]
      },
      "DeviceSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PHONE",
              "ANDROID_TV"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "name"
        ]
      },
      "SessionRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceSummaryDto"
          },
          "session": {
            "$ref": "#/components/schemas/SessionRefDto"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user",
          "device",
          "session"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "9876543210",
            "description": "Mobile number; +91 is assumed without a country code."
          },
          "password": {
            "type": "string",
            "description": "Any password of 1 to 200 characters."
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "phone",
          "password",
          "device"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ]
      },
      "SessionItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "device": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/DeviceSummaryDto"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "object",
            "format": "date-time",
            "nullable": true
          },
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "device",
          "createdAt",
          "lastUsedAt",
          "current"
        ]
      },
      "SessionListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionItemDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "RenameDeviceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Living Room TV"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Janak"
          }
        },
        "required": [
          "displayName"
        ]
      },
      "TvDto": {
        "type": "object",
        "properties": {
          "installId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Living Room TV"
          },
          "type": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "osVersion": {
            "type": "string"
          },
          "appVersion": {
            "type": "string"
          }
        },
        "required": [
          "installId",
          "name"
        ]
      },
      "CreatePairingDto": {
        "type": "object",
        "properties": {
          "tv": {
            "$ref": "#/components/schemas/TvDto"
          }
        },
        "required": [
          "tv"
        ]
      },
      "ClaimDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "1234",
            "description": "The 4-digit code on the TV. Spaces and dashes are ignored."
          }
        },
        "required": [
          "code"
        ]
      },
      "ApproveDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bedroom TV",
            "description": "Rename the TV while connecting it."
          }
        }
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client-generated UUID; makes the request safe to retry."
          },
          "sourceUrl": {
            "type": "string",
            "example": "https://cdn.example.com/a/My.Holiday.2024.mp4"
          },
          "title": {
            "type": "string",
            "description": "Defaults to a title derived from the link."
          },
          "sizeBytes": {
            "type": "number",
            "description": "File size in bytes, if the saving device could read it."
          },
          "format": {
            "type": "string",
            "example": "MP4",
            "description": "Short container/stream name for display."
          },
          "thumbnailUrl": {
            "type": "string",
            "description": "A picture the link advertises (og:image). http(s) only."
          }
        },
        "required": [
          "sourceUrl"
        ]
      },
      "RenameVideoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "PlaybackDto": {
        "type": "object",
        "properties": {
          "positionMs": {
            "type": "number",
            "description": "Where the viewer stopped, in milliseconds."
          },
          "durationMs": {
            "type": "number"
          }
        },
        "required": [
          "positionMs"
        ]
      }
    }
  }
}
