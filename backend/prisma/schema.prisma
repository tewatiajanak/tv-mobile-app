generator client {
  provider = "prisma-client-js"
}

// MongoDB (ADR-0006). There are no migration files: `prisma db push` syncs collections and
// indexes. Ids are UUIDv7 strings stored in `_id`, generated by the application.
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Bookkeeping only.
model SchemaMeta {
  key       String   @id @map("_id")
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schema_meta")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum DeviceType {
  PHONE
  ANDROID_TV
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  DEVICE_REMOVED
  ADMIN
  EXPIRED
  USER_SUSPENDED
}

/// Accounts sign in with mobile number + password (ADR-0008); the number is not verified.
model User {
  id           String     @id @map("_id")
  phoneE164    String     @unique @map("phone_e164")
  displayName  String     @map("display_name")
  /// scrypt, see common/utils/crypto.ts. Never returned by the API.
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  /// Bumped to invalidate every access token of the user at once.
  tokenVersion Int        @default(0) @map("token_version")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

/// One row per app install. A revoked device that signs in again gets a new row.
model Device {
  id           String     @id @map("_id")
  userId       String     @map("user_id")
  installId    String     @map("install_id")
  type         DeviceType
  name         String
  manufacturer String?
  model        String?
  osVersion    String?    @map("os_version")
  appVersion   String?    @map("app_version")
  lastSeenAt   DateTime?  @map("last_seen_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([userId, installId])
  @@map("devices")
}

/// A sign-in on one device. Only hashes of refresh tokens are stored.
model Session {
  id                   String               @id @map("_id")
  userId               String               @map("user_id")
  deviceId             String               @map("device_id")
  refreshTokenHash     String               @unique @map("refresh_token_hash")
  /// The token replaced by the last rotation; presenting it again is reuse.
  prevRefreshTokenHash String?              @map("prev_refresh_token_hash")
  rotatedAt            DateTime?            @map("rotated_at")
  expiresAt            DateTime             @map("expires_at")
  lastUsedAt           DateTime?            @map("last_used_at")
  userAgent            String?              @map("user_agent")
  revokedAt            DateTime?            @map("revoked_at")
  revokeReason         SessionRevokeReason? @map("revoke_reason")
  createdAt            DateTime             @default(now()) @map("created_at")

  @@index([userId])
  @@index([deviceId])
  @@index([prevRefreshTokenHash])
  @@map("sessions")
}

/// A saved video link. The backend stores the link and where the user stopped watching; it
/// never fetches, stores or relays the video itself (ADR-0005).
model Video {
  id                  String    @id @map("_id")
  userId              String    @map("user_id")
  title               String
  sourceUrl           String    @map("source_url")
  /// sourceUrl without fragment and tracking parameters; what duplicates are judged on.
  normalizedUrl       String    @map("normalized_url")
  urlHash             String    @map("url_hash")
  sourceDomain        String    @map("source_domain")
  createdFromDeviceId String?   @map("created_from_device_id")
  /// Reported by the device that saved the link (it asks the source for headers only). Display
  /// only: the backend never contacts the source itself.
  sizeBytes           BigInt?   @map("size_bytes")
  format              String?
  /// A picture the link itself advertises (a web page's og:image). Never a frame taken from the video.
  thumbnailUrl        String?   @map("thumbnail_url")
  /// Resume point, shared by all the user's devices. Last write wins.
  positionMs          Int       @default(0) @map("position_ms")
  durationMs          Int?      @map("duration_ms")
  lastPlayedAt        DateTime? @map("last_played_at")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  /// Always written (null when live) so `deletedAt: null` filters match (ADR-0006).
  deletedAt           DateTime? @map("deleted_at")

  @@index([userId, createdAt])
  @@index([userId, urlHash])
  @@map("videos")
}

enum PairingStatus {
  PENDING
  CLAIMED
  APPROVED
  CONSUMED
  REJECTED
  EXPIRED
  CANCELLED
}

/// A TV waiting to be connected by a signed-in phone. Codes and poll tokens are stored as hashes.
model PairingSession {
  id              String        @id @map("_id")
  /// Not unique: 4-digit codes repeat. Only one *open* session may hold a code (checked in code).
  codeHash        String        @map("code_hash")
  pollTokenHash   String        @map("poll_token_hash")
  status          PairingStatus @default(PENDING)
  tvInstallId     String        @map("tv_install_id")
  tvName          String        @map("tv_name")
  tvManufacturer  String?       @map("tv_manufacturer")
  tvModel         String?       @map("tv_model")
  tvOsVersion     String?       @map("tv_os_version")
  tvAppVersion    String?       @map("tv_app_version")
  claimedByUserId String?       @map("claimed_by_user_id")
  claimedAt       DateTime?     @map("claimed_at")
  approvedAt      DateTime?     @map("approved_at")
  createdDeviceId String?       @map("created_device_id")
  /// The TV's sign-in, AES-GCM encrypted, held only between approval and pickup (ADR-0007).
  tokensEnc       String?       @map("tokens_enc")
  consumedAt      DateTime?     @map("consumed_at")
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([tvInstallId])
  @@index([codeHash])
  @@map("pairing_sessions")
}

/// Fixed-window counters for rate limits (replaces Redis, ADR-0007). `_id` is "<key>|<window>".
/// A TTL index on expires_at (prisma/indexes.ts) deletes old windows.
/// The one admin sign-in (the owner). A single document with id "master"; absent until the
/// password is first changed, and until then the initial ADMIN_PASSWORD applies.
model AdminCredential {
  id           String    @id @map("_id")
  /// scrypt, see common/utils/crypto.ts.
  passwordHash String    @map("password_hash")
  /// Bumped on every password change so older admin tokens stop working.
  tokenVersion Int       @default(0) @map("token_version")
  /// HMAC of the pending reset code; the code itself is never stored.
  otpHash      String?   @map("otp_hash")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpAttempts  Int       @default(0) @map("otp_attempts")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_credentials")
}

model RateLimit {
  id        String   @id @map("_id")
  count     Int
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}
