# Copy to .env for local development. Real .env files are git-ignored.
# Every variable is validated at boot (src/config/env.schema.ts); the process refuses to start if one is invalid.

# development | test | production
NODE_ENV=development
# development | staging | production
APP_ENV=development
PORT=3000

# MongoDB. Must be a replica set (Atlas always is): transactions need one.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/videobridge?retryWrites=true&w=majority
# Docker: mongodb://localhost:27017/videobridge?replicaSet=rs0&directConnection=true
DATABASE_URL=mongodb://localhost:27017/videobridge?replicaSet=rs0&directConnection=true
# Optional. Leave unset to run without Redis (ADR-0007).
# REDIS_URL=redis://localhost:6379/0

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins. Empty = CORS closed.
CORS_ORIGINS=http://localhost:5173
# Defaults to true unless APP_ENV=production
SWAGGER_ENABLED=true
# Only true when running behind a trusted reverse proxy
TRUST_PROXY=false

# --- Authentication (Phase 2) ---
# Signs access tokens. At least 32 characters; generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-1234
JWT_ACCESS_TTL_SECONDS=900
# Sign-in lasts this long since the app was last used (sliding), so users are not asked again.
REFRESH_TTL_DAYS_PHONE=180
REFRESH_TTL_DAYS_TV=180
REFRESH_REUSE_GRACE_SECONDS=20
# Salt for hashing client IPs in rate limits and logs. At least 16 characters.
IP_HASH_SALT=change-me-change-me-1234
DEFAULT_PHONE_REGION=IN

# --- TV pairing (Phase 3) ---
# Keys for hashing pairing codes and encrypting the tokens waiting for the TV. At least 32 characters.
PAIRING_SECRET=change-me-change-me-change-me-change-me-5678
PAIRING_TTL_SECONDS=300

# --- Admin page ---
# The users page at /admin. Only ADMIN_PHONE can sign in. Leave either of the first two empty to
# switch the page off (404).
ADMIN_PHONE=
# First password only (8+ characters). After it is changed on the page this value is ignored.
ADMIN_PASSWORD=
# "Forgot password" emails a code to ADMIN_EMAIL through Resend (https://resend.com). With the
# default sender, Resend only delivers to the address the Resend account was created with.
ADMIN_EMAIL=
RESEND_API_KEY=
